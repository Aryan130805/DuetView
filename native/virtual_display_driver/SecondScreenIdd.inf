;
; SecondScreenIdd.inf
; Windows Indirect Display Driver (IddCx) Installation Package
;

[Version]
Signature="$WINDOWS NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=SecondScreenIdd.cat
DriverVer=10/31/2026,1.0.0.1
PnpLockDown=1

[DestinationDirs]
DefaultDestDir = 12
UMDriverCopy   = 12,UMDF

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
SecondScreenIdd.dll = 1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=SecondScreenIdd_Install, Root\SecondScreenIdd

[SecondScreenIdd_Install.NT]
CopyFiles=UMDriverCopy

[SecondScreenIdd_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRd_ServiceInstall

[SecondScreenIdd_Install.NT.Wdf]
UmdfService=SecondScreenIdd,SecondScreenIdd_Install_Service
UmdfServiceOrder=SecondScreenIdd
UmdfHostProcessSharing=ProcessSharingDisabled

[SecondScreenIdd_Install_Service]
UmdfLibraryVersion=2.25
ServiceBinary=%12%\UMDF\SecondScreenIdd.dll
IddPlatform=1

[WUDFRd_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[UMDriverCopy]
SecondScreenIdd.dll

[Strings]
ManufacturerName="SecondScreen Project"
DiskName="SecondScreen Virtual Display Installation Disk"
DeviceName="SecondScreen Virtual Extended Display"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"

